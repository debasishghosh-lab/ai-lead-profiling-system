        "jsCode": "// Parse the JSON returned by the LLM\nconst ai = JSON.parse($json.text);\n\n// Get original webhook data\nconst webhook = $('Webhook').first().json.body;\n\nreturn {\n  json: {\n    timestamp: new Date().toISOString(),\n    name: webhook.name,\n    email: webhook.email,\n    company: webhook.company,\n    query: webhook.query,\n    visit_history:webhook.visit_history\n  .map(item =>\n    `${item.page.replace(/_/g, \" \")} (${new Date(item.timestamp).toLocaleTimeString()})`\n  )\n  .join(\" → \"),\n    category: ai.category,\n    reason: ai.reason\n  }\n};"
